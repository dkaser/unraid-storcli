<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN>

<PLUGIN 
  name="storcli"
  author="Derek Kaser"
  version="2025.08.16"
  
  pluginURL="https://raw.githubusercontent.com/dkaser/unraid-storcli/main/plugin/storcli.plg"
  support="https://forums.unraid.net/topic/192112-plugin-storcli64/"
  min="7.0.0"
  
  icon="microchip"
>

<CHANGES>
<![CDATA[

### 2025.08.16

fix: switch to "full" instead of "lite" binaries

### 2025.08.09

- feat: add additional storcli versions (storcli-3205, storcli2)

### 2025.07.19

Fix: add symbolic link for storcli


For older releases, see https://github.com/dkaser/unraid-storcli/releases
]]>
</CHANGES>

<FILE Name="/boot/config/plugins/storcli/unraid-storcli-2025.08.16-noarch-1.txz">
<URL>https://github.com/dkaser/unraid-storcli/releases/download/2025.08.16/unraid-storcli-2025.08.16-noarch-1.txz</URL>
<SHA256>f033ba19fd99cad37479cf07049991a8437aaf1c9d79e4f37df6affbe006c184</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
upgradepkg --install-new /boot/config/plugins/storcli/unraid-storcli-2025.08.16-noarch-1.txz

# cleanup old versions
rm -f $(ls /boot/config/plugins/storcli/unraid-storcli-*.txz 2>/dev/null | grep -v '2025.08.16')

echo ""
echo "----------------------------------------------------"
echo " storcli has been installed."
echo " Version: 2025.08.16"
echo "----------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
removepkg unraid-storcli

rm -rf /usr/local/emhttp/plugins/storcli
rm -rf /boot/config/plugins/storcli
]]>
</INLINE>
</FILE>

</PLUGIN>
